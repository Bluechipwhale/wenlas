# Browse the imported catalogue independently of any connected database.
# Set false only after configuring a dedicated Wenlas backend below.
WENLAS_CATALOGUE_MODE=true
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Accepts Supabase's sb_publishable_ public key in this variable.
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
# Optional when reservation expiry runs directly through Supabase Cron.
CRON_SECRET=
# Only permits a sandbox administrator on localhost, never production.
LOCAL_DEMO=true
LOCAL_DATABASE_PATH=.data/wenlas.sqlite
# Deployment tools only; never NEXT_PUBLIC_ and never included in the client.
DATABASE_URL=
DATABASE_CA_PATH=

# Dedicated Wenlas inventory database (never use the previous business database).
WENLAS_DB_HOST=127.0.0.1
WENLAS_DB_PORT=3306
WENLAS_DB_NAME=
WENLAS_DB_USER=
WENLAS_DB_PASSWORD=
WENLAS_DB_TLS=false
WENLAS_OWNER_EMAIL=
# Private, random one-time owner setup code; keep out of Git.
WENLAS_SETUP_TOKEN=
# Local inventory storage is for development only; production requires MySQL.
WENLAS_LOCAL_INVENTORY=true
WENLAS_INVENTORY_SQLITE_PATH=.data/wenlas-inventory.sqlite
